# All values are optional. Nothing here is secret — NEXT_PUBLIC_* values are shipped to the browser.
# Until these are set, the site shows clearly labelled "not configured yet" states instead of invented details.

# Public site URL without trailing slash (used for canonical URLs, sitemap, Open Graph).
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=

# Public contact email that inquiries should be handed off to (opens the visitor's own email app).
NEXT_PUBLIC_CONTACT_EMAIL=

# WhatsApp number in international format, digits only (example format: 15551234567).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional public profile URLs.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_X_URL=
